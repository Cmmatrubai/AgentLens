{
  "name": "agentlens",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agentlens": "tsx --conditions=development apps/cli/src/developmentEntry.ts",
    "build": "tsc -b --pretty false && pnpm --filter @agentlens/web build",
    "build:web": "pnpm --filter @agentlens/web build",
    "test": "vitest --run",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
